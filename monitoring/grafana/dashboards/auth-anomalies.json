{
  "title": "Authentication Anomalies",
  "uid": "logiflow-auth-anomalies",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Auth Failures",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(logiflow_auth_failures_total[5m])"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current Unauthorized Socket Attempts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(logiflow_socket_unauthorized_total[2m]))"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      }
    }
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "security",
    "auth"
  ]
}
