{
  "title": "Threat Overview",
  "uid": "logiflow-threat-overview",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Unauthorized Socket Attempts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(logiflow_socket_unauthorized_total[5m])"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Falco Critical Alerts",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".*falco.*\"} |= \"CRITICAL\""
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "security",
    "threats"
  ]
}
