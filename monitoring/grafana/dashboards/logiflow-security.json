{
  "title": "LogiFlow Security Dashboard",
  "uid": "logiflow-security",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "5s",
  "tags": ["logiflow", "security", "devsecops"],
  "time": {"from": "now-30m", "to": "now"},
  "links": [
    {
      "title": "Security Pipeline Status",
      "type": "link",
      "url": "https://github.com/AnderssonProgramming/devsecops-threat-monitor/actions"
    },
    {
      "title": "Open Traces Dashboard",
      "type": "link",
      "url": "/d/logiflow-traces/logiflow-traces-dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Auth Failures Over Time",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(logiflow_auth_failures_total[5m])) or vector(0)", "legendFormat": "auth failures/sec"}],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Active Socket Connections by Role",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(logiflow_socket_connections{role=~\"admin|conductor|unauthorized\"}) or vector(0)"}],
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Webhook Request Rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "(sum(rate(logiflow_webhook_requests_total[1m])) * 60) or vector(0)", "legendFormat": "req/min"}],
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8}
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Falco Alerts Feed",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{container=~\".*falco.*\"}"}],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top 5 Attacker IPs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "topk(5, sum by (service) (count_over_time({service=~\"gateway|realtime|falco\"} |= \"Unauthorized\" [15m])))"}],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Container Anomalies",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "sum by (rule) (count_over_time({container=~\".*falco.*\"} | json | rule=~\".+\" [30m]))"}],
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Dependency CVE Summary",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "logiflow_dependency_cve_total or vector(0)"}],
      "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8}
    },
    {
      "id": 8,
      "type": "text",
      "title": "Security Pipeline Status",
      "options": {
        "mode": "markdown",
        "content": "[Open GitHub Actions](https://github.com/AnderssonProgramming/devsecops-threat-monitor/actions)"
      },
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8}
    }
  ]
}
