{
  "title": "LogiFlow Security Dashboard",
  "uid": "logiflow-security-provisioning",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Auth Failures Over Time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(logiflow_auth_failures_total[5m])"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Falco Alerts Feed",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".*falco.*\"}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "security",
    "monitoring"
  ]
}
